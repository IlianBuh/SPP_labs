# Скопируйте в .env и задайте свои значения перед запуском:
#   cp .env.example .env
#   docker compose --env-file .env up
#
# Для локального запуска без Docker:
#   export $(grep -v '^#' .env | xargs) && npm start

# Секрет для подписи JWT-токенов (обязательно смените в продакшене)
JWT_SECRET=dev-secret-change-me

# Учётные данные первого админа (создаётся при первом запуске, idempotent)
ADMIN_EMAIL=admin@example.com
ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin123