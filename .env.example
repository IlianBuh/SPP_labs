# Скопируйте в .env и задайте свои значения перед запуском:
#   cp .env.example .env
#   docker compose up -d   # поднимет локальный PostgreSQL
#   npm run dev

# Порт HTTP-сервера (на Render задаётся автоматически)
PORT=3000

# Строка подключения к PostgreSQL.
# Локально: docker compose up -d (см. docker-compose.yaml).
# Для Supabase используйте direct connection (порт 5432, НЕ pgbouncer 6543).
DATABASE_URL=postgresql://postgres:MrvFVkugTWm4e4yT@db.tyynxyhqexrhmjsrnsaz.supabase.co:5432/postgres

# Секрет для подписи JWT-токенов (смените в продакшене!)
JWT_SECRET=dev-secret-change-me

# Время жизни сессии/JWT, часы
SESSION_TTL_HOURS=24

# Кулдаун покраски одной клетки, мс
COOLDOWN_MS=2000

# Размер холста (квадрат GRID_SIZE x GRID_SIZE)
GRID_SIZE=100

# Кол-во цветов в палитре
PALETTE=16

# Размер кольцевого буфера последних операций (для дельт при reconnect)
OP_LOG_SIZE=5000

# Как часто сбрасывать операции в БД одной транзакцией, мс
PERSIST_FLUSH_MS=100

# Уровень логирования: debug | info | warn | error
LOG_LEVEL=info