# Скопируйте в .env и задайте свои значения перед запуском:
#   cp .env.example .env
#   docker compose --env-file .env up
#
# Для локального запуска без Docker:
#   export $(grep -v '^#' .env | xargs) && npm start

# Секрет для подписи JWT-токенов (обязательно смените в продакшене)
JWT_SECRET=dev-secret-change-me

# Уровень логирования: info (по умолчанию) | warn | error
# LOG_LEVEL=info

# Учётные данные первого админа (создаётся при первом запуске, idempotent)
ADMIN_EMAIL=admin@example.com
ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin123

# Защита от подбора паролей
# Максимум неудачных попыток для пары (логин + IP) до блокировки
LOGIN_MAX_ATTEMPTS=5
# Время блокировки пары после превышения попыток, мс (15 минут)
LOGIN_LOCKOUT_MS=900000
# Максимум запросов на auth-эндпоинты с одного IP в окно
LOGIN_IP_MAX_ATTEMPTS=20
# Окно IP-лимита, мс (15 минут)
LOGIN_IP_WINDOW_MS=900000

# Контроль активных сессий
# Максимум одновременно активных сессий на пользователя (старые вытесняются)
MAX_SESSIONS_PER_USER=5

# Сброс пароля
# Время жизни ссылки сброса, мс (60 минут)
RESET_TOKEN_TTL_MS=3600000
# Базовый URL приложения для ссылок сброса пароля
APP_BASE_URL=http://localhost:3000

# Доставка email (SMTP). Если SMTP_HOST пустой — ссылка сброса пишется в лог (dev-fallback)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=