MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=atlas_lab
HOST=127.0.0.1
PORT=4000
CATALOG_PORT=4001
WORKSPACE_PORT=4002
CATALOG_URL=http://127.0.0.1:4001/graphql
WORKSPACE_URL=http://127.0.0.1:4002/graphql
# Change for deployments across hosts. Use the same secret in all services.
INTERNAL_SECRET=local-lab-secret-change-me
# Optional: when set, mutations require this token (enter it in the UI).
ADMIN_TOKEN=
IMPORT_TARGET=10500
AUTO_IMPORT=true
REQUESTS_PER_MINUTE=180
MAX_CONCURRENT_REQUESTS=30
UPSTREAM_TIMEOUT_MS=30000
MONGO_SELECTION_TIMEOUT_MS=20000
WORKER_LEASE_MS=90000
# Identify the application to Open Library. Optionally include a contact email.
IMPORT_USER_AGENT=AtlasLab/1.0 (educational catalog)
